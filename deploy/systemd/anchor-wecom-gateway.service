[Unit]
Description=Anchor Rust WeCom Gateway
Requires=anchor.service
After=anchor.service
PartOf=anchor.service

[Service]
Type=simple
User=anchor
Group=anchor
WorkingDirectory=/opt/anchor/current/anchor-runtime
EnvironmentFile=/etc/anchor/wecom-gateway.env
Environment=HOME=/var/lib/anchor
ExecStart=/opt/anchor/current/anchor-runtime/bin/anchor-wecom-gateway
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/anchor/channels/wecom
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
