# Copy to /etc/anchor/wecom-gateway.env and set root:root 0600.
WECOM_CHANNEL_STATE=/var/lib/anchor/channels/wecom
WECOM_BOT_ID=REPLACE_WITH_WECOM_BOT_ID
WECOM_BOT_SECRET=REPLACE_WITH_WECOM_BOT_SECRET
ANCHOR_CHANNEL_CONTROL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ANCHOR_CHANNEL_CONTROL_DESCRIPTOR=/var/lib/anchor/channels/wecom/control.json

ANCHOR_WECOM_USERS=REPLACE_WITH_COMMA_SEPARATED_ALLOWED_USER_IDS
ANCHOR_WECOM_SEND_USERS=REPLACE_WITH_COMMA_SEPARATED_SEND_USER_IDS

ANCHOR_CHANNEL_WEBHOOK_URL=http://127.0.0.1:8077/channels/wecom/events
ANCHOR_API_KEY=REPLACE_WITH_SECRET_ALSO_LISTED_IN_ANCHOR_API_KEYS
