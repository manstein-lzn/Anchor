{
  "graph_id": "academic-research",
  "name": "Academic Literature Review",
  "entry_node_id": "start",
  "metadata": {
    "purpose": "Plan, gather evidence, write a reader-facing survey, then review substance and craft"
  },
  "nodes": [
    {
      "id": "start",
      "type": "artifact",
      "name": "Research question"
    },
    {
      "id": "plan",
      "type": "agent",
      "name": "Plan and refine",
      "agent_ref": "agents.academic.planner",
      "metadata": {
        "context_mode": "full"
      }
    },
    {
      "id": "gather",
      "type": "agent",
      "name": "Search, read and record evidence",
      "agent_ref": "agents.academic.gatherer",
      "metadata": {
        "context_mode": "full"
      }
    },
    {
      "id": "write",
      "type": "agent",
      "name": "Write the reader-facing paper",
      "agent_ref": "agents.academic.writer",
      "metadata": {
        "context_mode": "full"
      }
    },
    {
      "id": "review",
      "type": "agent",
      "name": "Review substance and craft",
      "agent_ref": "agents.academic.reviewer",
      "metadata": {
        "context_mode": "full"
      }
    },
    {
      "id": "check",
      "type": "loop",
      "name": "Evidence and craft gate",
      "metadata": {
        "context_mode": "full",
        "behavior_ref": "academic.review_gate"
      },
      "exit_condition": "output.review.verdict == 'pass' || output.review.verdict == 'blocked'"
    },
    {
      "id": "needs_input",
      "type": "human_task",
      "name": "Operator decision",
      "metadata": {
        "context_mode": "full"
      }
    },
    {
      "id": "report",
      "type": "artifact",
      "name": "Export paper",
      "metadata": {
        "context_mode": "full",
        "behavior_ref": "academic.report"
      }
    }
  ],
  "edges": [
    {
      "source": "start",
      "target": "plan",
      "input_mapping": {
        "request": "inputs"
      }
    },
    {
      "source": "plan",
      "target": "gather",
      "input_mapping": {
        "plan": "outputs.plan",
        "request": "inputs"
      }
    },
    {
      "source": "gather",
      "target": "write",
      "input_mapping": {
        "evidence": "outputs.gather",
        "plan": "outputs.plan",
        "request": "inputs"
      }
    },
    {
      "source": "write",
      "target": "review",
      "input_mapping": {
        "manuscript": "outputs.write",
        "evidence": "outputs.gather",
        "plan": "outputs.plan",
        "request": "inputs"
      }
    },
    {
      "source": "review",
      "target": "check",
      "input_mapping": {
        "review": "outputs.review",
        "manuscript": "outputs.write",
        "evidence": "outputs.gather",
        "plan": "outputs.plan",
        "request": "inputs"
      }
    },
    {
      "source": "check",
      "target": "gather",
      "condition": "output.review.verdict == 'revise' && output.review.target == 'evidence'",
      "input_mapping": {
        "feedback": "outputs.check",
        "plan": "outputs.check.plan",
        "request": "outputs.check.request"
      }
    },
    {
      "source": "check",
      "target": "write",
      "condition": "output.review.verdict == 'revise' && output.review.target == 'manuscript'",
      "input_mapping": {
        "feedback": "outputs.check",
        "evidence": "outputs.check.evidence",
        "plan": "outputs.check.plan",
        "request": "outputs.check.request"
      }
    },
    {
      "source": "check",
      "target": "needs_input",
      "condition": "output.review.verdict == 'blocked'",
      "input_mapping": {
        "feedback": "outputs.check"
      }
    },
    {
      "source": "needs_input",
      "target": "plan",
      "input_mapping": {
        "feedback": "outputs.check",
        "operator_decision": "outputs.needs_input",
        "request": "outputs.check.request"
      }
    },
    {
      "source": "check",
      "target": "report",
      "condition": "output.review.verdict == 'pass'",
      "input_mapping": {
        "approved": "outputs.check"
      }
    }
  ]
}
