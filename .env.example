# Copy to .env, run npm --prefix apps/web ci, then ./scripts/dev.sh start.
# .env is sourced as shell configuration; explicit exported settings take precedence.
# ANCHOR_DEV_ENV_FILE selects another file; set it to - to disable loading.
# Never commit the copy with real values. Paths must be absolute.

# scripts/dev.sh defaults to .local/rust and initializes a dev Graph with a true Op.
# Missing Host/Web build outputs are built once; startup submits no model work.
# ANCHOR_DEV_ROOT=/absolute/path/to/rust
# ANCHOR_RUNNER_BINARY=/absolute/path/to/anchor-runner-host
# ANCHOR_RUNNER_CATALOG_ROOT=/absolute/path/to/rust/catalog
# ANCHOR_RUNNER_BUNDLE_ROOT=/absolute/path/to/rust/catalog/dev
# ANCHOR_RUNNER_STATE_ROOT=/absolute/path/to/rust/state
# ANCHOR_RUNNER_WORKSPACE_ROOT=/absolute/path/to/rust/workspaces
# ANCHOR_RUNNER_LIBRARY_ROOT=/absolute/path/to/rust/library
# ANCHOR_RUNNER_SCHEDULES_PATH=/absolute/path/to/rust/state/schedules.json
# ANCHOR_RUNNER_WEB_ROOT=/absolute/path/to/Anchor/apps/web/dist
ANCHOR_RUNNER_GRAPH_NAME=dev
ANCHOR_RUNNER_LISTEN=127.0.0.1:8077
ANCHOR_RUNNER_ALLOWED_COMMANDS=sh,git,cat,printf,true
ANCHOR_BWRAP=/usr/bin/bwrap
ANCHOR_WEB_API_URL=http://127.0.0.1:8077
ANCHOR_WEB_PORT=5173

# The Anchor-built lean Goose ACP binary (upstream v1.53.0, see scripts/build-goose-acp.sh)
# is required only when submitting AgentNode/Pilot work.
# Set the absolute binary path and explicitly authorize its shared control network.
ANCHOR_GOOSE_BINARY=
ANCHOR_GOOSE_BINARY_SHA256=71e76c412597b2ecd96ed20d0706e7666f31c018216e7cb5d65c5ca5c44824a7
ANCHOR_GOOSE_ALLOW_SHARED_NETWORK=0

# One OpenAI-compatible model endpoint. No provider-specific name is required.
ANCHOR_MODEL_URL=https://api.example.com/v1
ANCHOR_MODEL_API_KEY=
ANCHOR_MODEL_NAME=your-model-name
# Optional names on the same endpoint/key; keep models.default unchanged.
ANCHOR_MODEL_ALIASES='{}'
ANCHOR_MODEL_WIRE_API=responses
DOCMOST_API_KEY=
# Optional JSON array; each key must be at least 32 bytes.
ANCHOR_API_KEYS='[]'
# Optional OAuth callback at the native Host (HTTPS, or loopback HTTP for development).
# ANCHOR_OAUTH_REDIRECT_URI=http://127.0.0.1:8077/oauth/callback

# WeCom application API (MCP tools)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com

# WeCom smart bot WebSocket and ordinary assistant Graph
ANCHOR_WECOM_GRAPH=wecom-assistant
ANCHOR_WECOM_REPLY_NODE=assistant
# Enterprise member userid, comma separated. Empty denies all; * explicitly permits all.
ANCHOR_WECOM_USERS=
# Optional outbound member allowlist; unset/empty inherits ANCHOR_WECOM_USERS.
ANCHOR_WECOM_SEND_USERS=
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Native ChannelSupervisor supplies state, control and webhook settings to its Gateway.
# Keep the Rust anchor-wecom-gateway binary available at the mounted Plugin's entrypoint.
# ANCHOR_CHANNEL_CONTROL_DESCRIPTOR=/absolute/path/to/rust/state/channels/wecom/control.json
# Set to one of the secrets in ANCHOR_API_KEYS above (at least 32 bytes).
ANCHOR_API_KEY=
