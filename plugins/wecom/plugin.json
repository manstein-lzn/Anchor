{
  "name": "企业微信",
  "description": "通过企业微信应用 API 发送消息、查询成员，并用官方 WebSocket 长连接接收智能机器人消息。",
  "skills": "skills/",
  "mcpServers": {
    "wecom": {
      "command": "python3",
      "args": ["server.py"],
      "cwd": ".",
      "env": {
        "WECOM_API_BASE_URL": "${WECOM_API_BASE_URL:-https://qyapi.weixin.qq.com}"
      },
      "optional_env_vars": [
          "WECOM_CORP_ID",
          "WECOM_AGENT_ID",
        "WECOM_SECRET"
        ]
    }
  }
}
