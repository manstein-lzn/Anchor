{
  "name": "anchor-pi",
  "version": "0.1.0",
  "description": "Durable planning and cognition updates for long-running Pi sessions",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "anchor"
  ],
  "pi": {
    "extensions": [
      "./src/extension.js"
    ]
  },
  "exports": {
    ".": "./src/extension.js",
    "./context": "./src/context.js",
    "./store": "./src/store.js",
    "./update": "./src/update.js"
  },
  "files": [
    "src/*.js",
    "python/**/*.py",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/context.js && node --check src/store.js && node --check src/update.js && node --check src/extension.js && python3 -m py_compile python/anchor_kernel.py python/anchor_core/*.py",
    "test": "node --test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typebox": "1.3.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
